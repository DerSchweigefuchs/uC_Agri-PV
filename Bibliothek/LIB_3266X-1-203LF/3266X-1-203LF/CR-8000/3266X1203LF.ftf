(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c121
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 60500
            (pt 0 0)
          )
        )
      )
      (pad r121_121
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 121000)
            (height 121000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c121h66
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 33000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c121))
          (noconnect (pad c121))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c121))
          (noconnect (pad c121))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c121))
          (noconnect (pad c121))
        )
        (padSet (footLayer Inner)
          (clearance (pad c121))
          (connect (pad c121))
          (noconnect (pad c121))
        )
        (padSet (footLayer Bottom)
          (connect (pad c121))
          (noconnect (pad c121))
        )
      )
      (padstack r121_121h66
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 33000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r121_121))
          (noconnect (pad r121_121))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r121_121))
          (noconnect (pad r121_121))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r121_121))
          (noconnect (pad r121_121))
        )
        (padSet (footLayer Inner)
          (clearance (pad r121_121))
          (connect (pad r121_121))
          (noconnect (pad r121_121))
        )
        (padSet (footLayer Bottom)
          (connect (pad r121_121))
          (noconnect (pad r121_121))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "3266X1203LF"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
